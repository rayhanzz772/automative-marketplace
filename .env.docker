# Copy this file to .env before running docker-compose:
#   cp .env.docker .env

NODE_ENV=development
APP_PORT=8000
PORT=8000

# ── JWT ──────────────────────────────────────────────────────
JWT_KEY=change-me-to-a-long-random-string
JWT_EXP=1d
APP_IV=change-me-iv-16ch
APP_SIGNATURE_KEY=change-me-signature
JWT_SECRET=change-me-jwt-secret

DB_USER=postgres
DB_PASS=postgres
DB_NAME=automative_marketplace
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONNECTION=postgresql
DB_SSL=false

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# For entry point purposes
RUN_SEED_BULK=true
SEED_BULK_COUNT=5000
